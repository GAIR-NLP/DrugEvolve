# LLM / Agents compatibility layer
DRUGEVOLVE_API_KEY=
DRUGEVOLVE_BASE_URL=https://api.openai.com/v1/
DRUGEVOLVE_AGENT_MODELS={}
DRUGEVOLVE_DEFAULT_MODEL=gpt-4o-mini
DRUGEVOLVE_REASONING_EFFORT=
DRUGEVOLVE_LOG_CONTENT=0
DRUGEVOLVE_PROMPT_DIR=

# Reproducible run
DRUGEVOLVE_RUN_NAME=demo
DRUGEVOLVE_RUNS_DIR=.drugevolve/runs
DRUGEVOLVE_REQUIRE_PREFLIGHT=1
DRUGEVOLVE_MAX_EXPERIMENTS=10
DRUGEVOLVE_MAX_CONSECUTIVE_FAILURES=3

# Compatibility-pipeline sampler (normally loaded from run_spec.yaml)
DRUGEVOLVE_SAMPLER_TYPE=ucb1
DRUGEVOLVE_SAMPLER_EXPLORATION_COEFFICIENT=1.414
DRUGEVOLVE_SAMPLER_NUM_ISLANDS=4
DRUGEVOLVE_SAMPLER_EXPLORATION_RATIO=0.2
DRUGEVOLVE_SAMPLER_EXPLOITATION_RATIO=0.3
DRUGEVOLVE_SAMPLER_FEATURE_DIMENSIONS=complexity,diversity
DRUGEVOLVE_SAMPLER_FEATURE_BINS=10

# Evaluation and direct GPU training limits
DRUGEVOLVE_EVALUATION_TIMEOUT=3600
DRUGEVOLVE_TRAINING_TIMEOUT=7200
CUDA_DEVICE=0

# Score composition (defaults preserve objective-only selection)
DRUGEVOLVE_OBJECTIVE_SCORE_WEIGHT=1.0
DRUGEVOLVE_LLM_SCORE_WEIGHT=0.0
